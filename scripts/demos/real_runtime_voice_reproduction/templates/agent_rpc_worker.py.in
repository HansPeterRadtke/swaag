#!/usr/bin/env python3
"""Private no-action SWAAG RPC process for the W111 voice integration.

Actual AgentRuntime and CommunicationService.handle_client; no model or service
methods are substituted. Only this process's listener and resources are closed.
The Python audit hook restricts Python egress/process/file operations. It is a
test admission guard, not an OS sandbox; native SQLite uses validated roots.
"""
from __future__ import annotations
import argparse
import asyncio
from collections import Counter
from dataclasses import asdict
import hashlib
import importlib.metadata
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time
from urllib.parse import urlsplit

sys.dont_write_bytecode = True


def unique_json(path: Path, value) -> None:
    raw = (json.dumps(value, ensure_ascii=False, indent=2, default=str) + "\n").encode()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as sink:
        sink.write(raw)
        sink.flush()
        os.fsync(sink.fileno())


def under_root(value, root: Path) -> bool:
    if isinstance(value, int):
        return True  # Only descriptors already granted to this process.
    try:
        path = Path(os.fsdecode(value)).absolute().resolve()
        return path == root or root in path.parents
    except (TypeError, ValueError, OSError):
        return False


def install_guard(root: Path, model_proxy_port: int):
    counts = Counter()
    violations = []

    def rejected(event, detail):
        violations.append({"event": event, "detail": str(detail)[:500]})
        raise PermissionError("Private SWAAG test boundary: " + event)

    def allowed_peer(address):
        return (isinstance(address, tuple) and len(address) >= 2
                and address[0] == "127.0.0.1" and address[1] == model_proxy_port)

    def audit(event, args):
        if event in {"socket.connect", "socket.sendto"}:
            address = args[1] if event == "socket.connect" else args[-1]
            if not allowed_peer(address):
                rejected(event, address)
            counts[event] += 1
        elif event in {"socket.getaddrinfo", "socket.gethostbyname", "socket.gethostbyname_ex"}:
            host = args[0]
            if host not in {"127.0.0.1", "localhost", None}:
                rejected(event, host)
            counts[event] += 1
        elif event in {"subprocess.Popen", "os.system", "os.exec", "os.posix_spawn",
                       "os.fork", "os.forkpty"}:
            rejected(event, "child process execution forbidden")
        elif event == "open":
            path, mode, flags = args
            write_flags = os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND
            if ((isinstance(flags, int) and flags & write_flags)
                    or (isinstance(mode, str) and any(c in mode for c in "wax+"))):
                if not under_root(path, root):
                    rejected(event, path)
                counts["file_write_open"] += 1
        elif event in {"os.remove", "os.rmdir", "os.mkdir", "os.chmod", "os.utime"}:
            if not under_root(args[0], root):
                rejected(event, args[0])
        elif event in {"os.rename", "os.link", "os.symlink"}:
            # No symlink is necessary to exercise this integration.
            if event == "os.symlink" or not all(under_root(p, root) for p in args[:2]):
                rejected(event, args[:2])
    sys.addaudithook(audit)
    return counts, violations


def validate_config(config, root: Path, port: int) -> dict:
    endpoint = urlsplit(config.model.base_url)
    assert endpoint.scheme == "http" and endpoint.hostname == "127.0.0.1"
    assert endpoint.port == port and endpoint.path in {"", "/"}
    assert not endpoint.username and not endpoint.password
    assert config.model.completion_endpoint == "/completion"
    assert config.model.tokenize_endpoint == "/tokenize"
    assert config.model.api_key_env == ""
    assert config.model.cache_enabled is False
    assert config.model.max_retries == 0
    assert 0 < config.model.max_generation_wall_seconds <= 180
    assert config.tools.enabled == []
    assert config.tools.staged_discovery is False
    assert config.tools.allow_stateful_tools is False
    assert config.tools.allow_side_effect_tools is False
    assert config.communication.enabled_tools == []
    assert config.communication.idle_work_mode == "finish_only"
    assert config.communication.preempt_shared_model is False
    assert not config.communication.model_routes
    assert not config.external_tools.mcp_servers
    assert config.mcp.enabled is False
    assert config.a2a_push.enabled is False
    assert config.embedding_index.enabled is False
    assert config.perception.enabled is False
    assert config.communication.open_webui_artifacts.enabled is False
    assert config.runtime.completion_evaluation_enabled is False
    for path in (config.sessions.root, config.agent_data.root, config.logging.file_path,
                 *config.tools.read_roots):
        assert under_root(path, root), "Configured path outside private evidence"
    assert not any(str(s).startswith(("local_config:", "environment:", "SWAAG_CONFIG:"))
                   for s in config.sources.values()), "Ambient configuration was loaded"
    return {
        "model": asdict(config.model),
        "tools": asdict(config.tools),
        "sessions": asdict(config.sessions),
        "agent_data_root": str(config.agent_data.root),
        "logging_file": str(config.logging.file_path),
        "communication_enabled_tools": config.communication.enabled_tools,
        "idle_work_mode": config.communication.idle_work_mode,
        "preempt_shared_model": config.communication.preempt_shared_model,
        "model_routes": config.communication.model_routes,
        "external_mcp_servers": list(config.external_tools.mcp_servers),
        "mcp_enabled": config.mcp.enabled,
        "a2a_push_enabled": config.a2a_push.enabled,
        "embedding_index_enabled": config.embedding_index.enabled,
        "perception_enabled": config.perception.enabled,
        "open_webui_artifacts_enabled": config.communication.open_webui_artifacts.enabled,
        "completion_evaluation_enabled": config.runtime.completion_evaluation_enabled,
        "config_fingerprint": config.config_fingerprint(),
        "configuration_source_kinds": sorted(set(config.sources.values())),
        "actual_handler": "swaag.communication.CommunicationService.handle_client",
        "background_serve_tcp_loops_started": False,
        "python_guard_is_os_sandbox": False,
    }


async def run(config, root: Path, ready_name: str, evidence: dict,
              counters, violations) -> int:
    from swaag.communication import CommunicationService
    from swaag.runtime import AgentRuntime
    from swaag.operations_log import configure_operations_log
    prefix = Path(ready_name).stem
    started = time.monotonic()
    log = None
    runtime = None
    service = None
    server = None
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    result = {"status": "startup_failed", "pid": os.getpid()}
    signals = []
    try:
        log = configure_operations_log(config, component="w111-private-rpc")
        runtime = AgentRuntime(config)
        actual_tools = runtime.tools.enabled_tools(config)
        if actual_tools:
            raise AssertionError("Runtime exposes tools despite no-action configuration")
        if runtime.runtime_external_tools.specs():
            raise AssertionError("Runtime exposes external tools")
        service = CommunicationService(runtime, orchestrator_runtime=runtime, max_concurrency=2)
        server = await asyncio.start_server(service.handle_client, "127.0.0.1", 0)
        port = int(server.sockets[0].getsockname()[1])
        for signum in (signal.SIGTERM, signal.SIGINT):
            loop.add_signal_handler(signum, stop.set)
            signals.append(signum)
        evidence["actual_enabled_tools"] = []
        evidence["actual_external_tool_specs"] = []
        evidence["runtime_source_path"] = str(Path(sys.modules["swaag.runtime"].__file__).resolve())
        evidence["communication_source_path"] = str(Path(sys.modules["swaag.communication"].__file__).resolve())
        unique_json(root / (prefix + "-effective.json"), evidence)
        ready = {
            "port": port, "host": "127.0.0.1", "pid": os.getpid(),
            "source_revision": evidence["source_revision"],
            "effective_safety_path": str(root / (prefix + "-effective.json")),
            "sessions_root": str(config.sessions.root),
            "actual_handler": evidence["actual_handler"],
            "tools_enabled": [],
        }
        unique_json(root / ready_name, ready)
        print(json.dumps(ready), flush=True)
        result["status"] = "ready"
        await stop.wait()
        result["status"] = "stopped"
        return 0
    except BaseException as exc:
        result.update(status="failed", error_type=type(exc).__name__, error=str(exc)[:600])
        raise
    finally:
        for signum in signals:
            loop.remove_signal_handler(signum)
        if server is not None:
            server.close()
            if service is not None:
                writers = list(service._client_writers)
                for writer in writers:
                    writer.close()
                if writers:
                    await asyncio.gather(*(w.wait_closed() for w in writers), return_exceptions=True)
            await server.wait_closed()
        if service is not None:
            await asyncio.to_thread(service.close, wait=True)
        if log is not None:
            log.shutdown(reason="private_rpc_worker_exit")
        result.update(
            elapsed_seconds=round(time.monotonic() - started, 6),
            listener_closed=server is None or not server.is_serving(),
            service_close_called=service is not None,
            audit_counts=dict(counters), boundary_violations=list(violations),
            state_retained_for_independent_replay=True,
        )
        unique_json(root / (prefix + "-lifecycle.json"), result)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", required=True, type=Path)
    parser.add_argument("--swaag-source", required=True, type=Path)
    parser.add_argument("--evidence", required=True, type=Path)
    parser.add_argument("--model-proxy-port", required=True, type=int)
    parser.add_argument("--ready-file", default="agent-ready.json")
    args = parser.parse_args()
    if sys.flags.optimize:
        raise ValueError("Safety assertions require ordinary non-optimized Python")
    if not 1 <= args.model_proxy_port <= 65535:
        raise ValueError("Invalid model proxy port")
    if Path(args.ready_file).name != args.ready_file or not args.ready_file.endswith(".json"):
        raise ValueError("ready-file must be a local JSON filename")
    root = args.evidence.absolute()
    if root.is_symlink() or root.resolve() != root or not root.is_dir():
        raise ValueError("Evidence must be an existing nonsymlink absolute directory")
    if not str(root).startswith("@@EVIDENCE_PREFIX@@"):
        raise ValueError("Evidence is outside the owned W111 attempt directory")
    if Path.cwd().resolve() != root:
        raise ValueError("Run from the private attempt directory to prevent ambient config")
    if (root / "config/local.toml").exists():
        raise ValueError("Ambient config/local.toml would be loaded")
    for name in (args.ready_file, Path(args.ready_file).stem + "-effective.json",
                 Path(args.ready_file).stem + "-lifecycle.json"):
        if (root / name).exists() or (root / name).is_symlink():
            raise FileExistsError("Refusing to overwrite worker lifecycle evidence")
    if not under_root(args.config, root) or args.config.is_symlink():
        raise ValueError("Config must be private and nonsymlinked")
    source = args.swaag_source.absolute().resolve()
    revision = subprocess.run(
        ["git", "-C", str(source), "rev-parse", "HEAD"],
        check=True, text=True, capture_output=True, timeout=8,
    ).stdout.strip()
    dirty = subprocess.run(
        ["git", "-C", str(source), "status", "--porcelain", "--untracked-files=no"],
        check=True, text=True, capture_output=True, timeout=8,
    ).stdout
    if dirty:
        raise ValueError("Tracked SWAAG source is dirty")
    sys.path.insert(0, str(source / "src"))
    counters, violations = install_guard(root, args.model_proxy_port)
    from swaag.config import load_config
    config = load_config([args.config], env={})
    evidence = validate_config(config, root, args.model_proxy_port)
    evidence.update(
        source_revision=revision,
        source_path=str(source),
        worker_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        config_sha256=hashlib.sha256(args.config.read_bytes()).hexdigest(),
        python=sys.version,
        config_file=str(args.config),
        ready_file=args.ready_file,
    )
    import sqlite3
    evidence["sqlite_version"] = sqlite3.sqlite_version
    evidence["dependency_versions"] = {}
    for name in ("requests", "pydantic", "opentelemetry-api", "cryptography"):
        try:
            evidence["dependency_versions"][name] = importlib.metadata.version(name)
        except importlib.metadata.PackageNotFoundError:
            evidence["dependency_versions"][name] = None
    return asyncio.run(run(config, root, args.ready_file, evidence, counters, violations))


if __name__ == "__main__":
    raise SystemExit(main())
